{
  "name": "defecttracker/permits",
  "description": "Production permit-to-work management application",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-zip": "*",
    "vlucas/phpdotenv": "^5.6",
    "ramsey/uuid": "^4.9",
    "chillerlan/php-qrcode": "^5.0",
    "minishlink/web-push": "^9.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Permits\\": "src/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8080 index.php",
    "migrate": "php bin/migrate.php",
    "lint": "php bin/lint.php",
    "assets": "php bin/validate-assets.php",
    "check": ["@lint", "@assets", "@test"],
    "reminders": "php bin/reminders.php",
    "test": "vendor/bin/phpunit"
  }
}
