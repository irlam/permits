{
  "name": "defecttracker/permits",
  "description": "Production permit-to-work management application",
  "license": "proprietary",
  "type": "project",
  "require": {
  "php": "^8.1",
  "ext-curl": "*",
  "ext-fileinfo": "*",
  "ext-json": "*",
  "ext-mbstring": "*",
  "ext-pdo": "*",
  "slim/slim": "^4.15",
  "slim/psr7": "^1.7",
  "vlucas/phpdotenv": "^5.6",
  "ramsey/uuid": "^4.9",
  "chillerlan/php-qrcode": "^5.0",
  "minishlink/web-push": "^9.0",
  "myclabs/deep-copy": "^1.13",
  "phpmailer/phpmailer": "^6.12",
  "simplehtmldom/simplehtmldom": "^2.0@RC",
  "smalot/pdfparser": "^2.12"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Permits\\": "src/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8080 index.php",
    "migrate": "php bin/migrate.php",
    "lint": "php bin/lint.php",
    "check": ["@lint", "@test"],
    "reminders": "php bin/reminders.php",
    "test": "vendor/bin/phpunit"
  }
}
