{
  "id": "hot-works-v1",
  "title": "Hot Works Permit",
  "meta": {
    "fields": [
      {
        "key": "permitNo",
        "label": "Permit Number",
        "type": "text"
      },
      {
        "key": "block",
        "label": "Site / Block",
        "type": "select",
        "options": [
          "Block 1",
          "Block 2",
          "Block 3",
          "Block 4"
        ]
      },
      {
        "key": "location",
        "label": "Location (exact area)",
        "type": "text"
      },
      {
        "key": "hwType",
        "label": "Hot Works Type",
        "type": "select",
        "options": [
          "Welding",
          "Cutting",
          "Grinding",
          "Soldering/Brazing",
          "Roofing Torch",
          "Other"
        ]
      },
      {
        "key": "contractor",
        "label": "Contractor",
        "type": "text"
      },
      {
        "key": "holder",
        "label": "Permit Holder",
        "type": "text"
      },
      {
        "key": "fireWatcher",
        "label": "Fire Watcher",
        "type": "text"
      },
      {
        "key": "validFrom",
        "label": "Valid From",
        "type": "datetime"
      },
      {
        "key": "validTo",
        "label": "Valid To",
        "type": "datetime"
      },
      {
        "key": "fai",
        "label": "Fire Alarm Isolation?",
        "type": "select",
        "options": [
          "no",
          "yes"
        ]
      },
      {
        "key": "faiDetails",
        "label": "Isolation Details",
        "type": "text"
      },
      {
        "key": "description",
        "label": "Work Description",
        "type": "textarea"
      }
    ]
  },
  "sections": [
    {
      "title": "PRE-WORK CONTROLS",
      "items": [
        "Area cleared of combustibles within min. 10m (incl. above/below/adjacent levels)",
        "Floors/walls/voids protected: non-combustible screens/blankets/spark containment",
        "Flammable liquids/pressurised containers removed from area"
      ],
      "fields": [
        {
          "label": "Fire Extinguisher Type & Location",
          "type": "text",
          "placeholder": "e.g. CO2 6kg – pillar A3"
        },
        {
          "label": "Combustible Materials Removed / Protected",
          "type": "textarea",
          "placeholder": "List materials and action taken"
        },
        {
          "label": "Hot Work Shield / Blanket Position",
          "type": "text",
          "placeholder": "Describe placement"
        },
        {
          "label": "Welding / Cutting / Grinding Process",
          "type": "select",
          "options": [
            "Welding",
            "Cutting – disc",
            "Cutting – torch",
            "Grinding",
            "Burning / brazing"
          ]
        }
      ]
    },
    {
      "title": "DURING WORK CONTROLS",
      "items": [
        "Continuous fire watch maintained for duration of hot works",
        "Sparks and heat migration monitored"
      ],
      "fields": [
        {
          "label": "Fire Watcher Name",
          "type": "text"
        },
        {
          "label": "Communication Method",
          "type": "select",
          "options": [
            "Radio",
            "Mobile phone",
            "Intercom",
            "Whistle"
          ]
        },
        {
          "label": "Fire Watch Check Interval",
          "type": "select",
          "options": [
            "Continuous",
            "Every 15 minutes",
            "Every 30 minutes"
          ]
        },
        {
          "label": "Monitoring Notes",
          "type": "textarea",
          "placeholder": "Record any incidents or concerns during fire watch"
        }
      ]
    },
    {
      "title": "POST-WORK & FIRE WATCH",
      "items": [
        "Immediate area inspected on completion; no smouldering",
        "Re-check at 60 minutes completed and recorded"
      ],
      "fields": [
        {
          "label": "Work Completion Time",
          "type": "time"
        },
        {
          "label": "Fire Watch End Time (min. 60 min after)",
          "type": "time"
        },
        {
          "label": "60-minute Re-check Completed By",
          "type": "text"
        },
        {
          "label": "Area Confirmed Clear",
          "type": "select",
          "options": [
            "Yes – no hotspots found",
            "No – action taken (detail below)"
          ]
        },
        {
          "label": "Post-watch Findings",
          "type": "textarea",
          "placeholder": "Note any hotspots found and action taken"
        }
      ]
    },
    {
      "title": "REINSTATEMENT / CLOSE-OUT",
      "items": [
        "Fire alarm reinstated and tested",
        "Permit closed by issuer and acknowledged by permit holder"
      ],
      "fields": [
        {
          "label": "Fire Alarm Reactivation Time",
          "type": "time"
        },
        {
          "label": "Reinstated By",
          "type": "text"
        },
        {
          "label": "Outstanding Actions",
          "type": "textarea",
          "placeholder": "Any follow-up actions required"
        },
        {
          "label": "Permit Close-out Reference",
          "type": "text"
        }
      ]
    }
  ],
  "signatures": [
    "issuer_issue",
    "holder_issue",
    "holder_return",
    "issuer_return"
  ]
}