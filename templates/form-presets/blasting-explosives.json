{
  "id": "blasting-explosives-v1",
  "title": "Blasting/Explosives Permit",
  "name": "Blasting/Explosives Permit",
  "description": "Permit for blasting or use of explosives, ensuring all regulatory and safety requirements are met.",
  "meta": {
    "fields": [
      {
        "key": "location",
        "label": "Location",
        "type": "text",
        "required": true
      },
      {
        "key": "date",
        "label": "Date",
        "type": "date",
        "required": true
      },
      {
        "key": "typeOfExplosive",
        "label": "Type of Explosive",
        "type": "text",
        "required": true
      },
      {
        "key": "quantity",
        "label": "Quantity",
        "type": "text",
        "required": false
      },
      {
        "key": "blastingPlanReference",
        "label": "Blasting Plan Reference",
        "type": "text",
        "required": false
      },
      {
        "key": "personnelInvolved",
        "label": "Personnel Involved",
        "type": "text",
        "required": true
      },
      {
        "key": "supervisor",
        "label": "Supervisor",
        "type": "text",
        "required": true
      },
      {
        "key": "signatures",
        "label": "Signatures",
        "type": "signature",
        "required": true
      },
      {
        "key": "validFrom",
        "label": "Valid From",
        "type": "datetime"
      },
      {
        "key": "validTo",
        "label": "Valid To",
        "type": "datetime"
      }
    ]
  },
  "sections": [
    {
      "title": "EXPLOSIVES MANAGEMENT",
      "items": [
        "Explosives inventory recorded",
        "Magazine secured and logged",
        "Competent shot-firer appointed",
        "Blast plan approved",
        "Seismograph monitoring arranged"
      ],
      "fields": [
        {
          "label": "Explosives Magazine Reference",
          "type": "text"
        },
        {
          "label": "Shot-firer Licence Number",
          "type": "text"
        },
        {
          "label": "Quantity and Type Authorised",
          "type": "text",
          "placeholder": "kg explosive / detonators"
        },
        {
          "label": "Seismograph / Monitoring Equipment ID",
          "type": "text",
          "placeholder": "Leave blank if not required"
        }
      ]
    },
    {
      "title": "AREA SECURITY",
      "items": [
        "Exclusion zone established and marked",
        "All personnel evacuated",
        "Traffic stopped",
        "Audible warnings given",
        "All-clear signal arranged"
      ],
      "fields": [
        {
          "label": "Exclusion Zone Radius (metres)",
          "type": "text"
        },
        {
          "label": "Evacuation Confirmed By",
          "type": "text"
        },
        {
          "label": "All-clear Signal Type",
          "type": "select",
          "options": [
            "Siren",
            "Radio communication",
            "Flag signal",
            "Combined signals"
          ]
        },
        {
          "label": "Misfire Procedure Reference",
          "type": "text"
        },
        {
          "label": "Post-blast Fume Clearance Time (minutes)",
          "type": "text",
          "placeholder": "Minimum 30 minutes in open, longer in confined areas"
        }
      ]
    },
    {
      "title": "AUTHORIZATION TO START",
      "fields": [
        {
          "key": "issuerName",
          "label": "Permit Issuer Name",
          "type": "text"
        },
        {
          "key": "issuerRole",
          "label": "Permit Issuer Role",
          "type": "text"
        },
        {
          "key": "holderName",
          "label": "Permit Holder Name",
          "type": "text"
        },
        {
          "key": "holderCompany",
          "label": "Holder Company",
          "type": "text"
        },
        {
          "key": "authorizationAt",
          "label": "Authorization Date/Time",
          "type": "datetime"
        }
      ]
    },
    {
      "title": "HAND-BACK AND CLOSE-OUT",
      "items": [
        "Work completed and area inspected",
        "Plant, tools and temporary controls removed",
        "Systems reinstated safely",
        "Area left clean and safe"
      ],
      "fields": [
        {
          "key": "workCompletedSummary",
          "label": "Work Completed Summary",
          "type": "textarea"
        },
        {
          "key": "areaLeftSafeBy",
          "label": "Area Left Safe By",
          "type": "text"
        },
        {
          "key": "handBackTo",
          "label": "Hand-back To (Name)",
          "type": "text"
        },
        {
          "key": "closedBy",
          "label": "Closed By",
          "type": "text"
        },
        {
          "key": "closedAt",
          "label": "Closure Date/Time",
          "type": "datetime"
        },
        {
          "key": "outstandingActions",
          "label": "Outstanding Actions",
          "type": "textarea"
        }
      ]
    }
  ],
  "signatures": [
    "issuer_issue",
    "holder_accept",
    "issuer_close"
  ]
}
