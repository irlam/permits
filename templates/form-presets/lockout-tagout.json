{
  "id": "lockout-tagout-v1",
  "title": "Lockout/Tagout Permit",
  "name": "Lockout/Tagout Permit",
  "description": "Permit for lockout/tagout procedures to ensure equipment is safely isolated before maintenance or repair.",
  "meta": {
    "fields": [
      {
        "key": "location",
        "label": "Location",
        "type": "text",
        "required": true
      },
      {
        "key": "date",
        "label": "Date",
        "type": "date",
        "required": true
      },
      {
        "key": "equipmentDescription",
        "label": "Equipment Description",
        "type": "text",
        "required": true
      },
      {
        "key": "workDescription",
        "label": "Work Description",
        "type": "textarea",
        "required": true
      },
      {
        "key": "isolationPoints",
        "label": "Isolation Points",
        "type": "textarea",
        "required": true
      },
      {
        "key": "lockout/TagoutDevicesApplied",
        "label": "Lockout/Tagout Devices Applied",
        "type": "checkbox",
        "required": true
      },
      {
        "key": "personnelInvolved",
        "label": "Personnel Involved",
        "type": "text",
        "required": true
      },
      {
        "key": "supervisor",
        "label": "Supervisor",
        "type": "text",
        "required": true
      },
      {
        "key": "signatures",
        "label": "Signatures",
        "type": "signature",
        "required": true
      }
    ]
  },
  "sections": [
    {
      "title": "ENERGY SOURCE IDENTIFICATION",
      "items": [
        "All energy sources identified",
        "Isolation points located",
        "Stored energy (pressure, springs) identified",
        "Secondary/backup systems checked",
        "Energy control procedures reviewed"
      ],
      "fields": [
        {
          "label": "Energy Sources Identified",
          "type": "multiselect",
          "options": [
            {
              "value": "electrical",
              "label": "Electrical"
            },
            {
              "value": "hydraulic",
              "label": "Hydraulic"
            },
            {
              "value": "pneumatic",
              "label": "Pneumatic"
            },
            {
              "value": "mechanical",
              "label": "Mechanical"
            },
            {
              "value": "thermal",
              "label": "Thermal"
            },
            {
              "value": "chemical",
              "label": "Chemical"
            },
            {
              "value": "gravitational",
              "label": "Gravitational / stored"
            }
          ]
        },
        {
          "label": "Energy Control Procedure Reference",
          "type": "text"
        },
        {
          "label": "Total Isolation Points",
          "type": "text",
          "placeholder": "Count of all isolators / valves / breakers"
        },
        {
          "label": "Backup / Secondary Systems Confirmed De-energised",
          "type": "select",
          "options": [
            "Yes",
            "No – not applicable",
            "N/A – no secondary systems"
          ]
        }
      ]
    },
    {
      "title": "ISOLATION & VERIFICATION",
      "items": [
        "Equipment shut down properly",
        "All isolation devices operated",
        "Personal locks and tags applied",
        "Isolation verified by test",
        "Group lockout box used if multiple workers"
      ],
      "fields": [
        {
          "label": "Lock / Tag Reference Numbers",
          "type": "textarea",
          "placeholder": "List each lock number and worker name"
        },
        {
          "label": "Verification Test Method",
          "type": "select",
          "options": [
            "Voltmeter / test lamp",
            "Pressure gauge / bleed-down",
            "Mechanical movement test",
            "Multiple methods – see notes"
          ]
        },
        {
          "label": "Group Lockout Box Used",
          "type": "select",
          "options": [
            "Yes",
            "No – individual locks only"
          ]
        },
        {
          "label": "Isolation Verified By",
          "type": "text"
        },
        {
          "label": "Re-energisation Authorised By",
          "type": "text"
        }
      ]
    },
    {
      "title": "AUTHORIZATION TO START",
      "fields": [
        {
          "key": "issuerName",
          "label": "Permit Issuer Name",
          "type": "text"
        },
        {
          "key": "issuerRole",
          "label": "Permit Issuer Role",
          "type": "text"
        },
        {
          "key": "holderName",
          "label": "Permit Holder Name",
          "type": "text"
        },
        {
          "key": "holderCompany",
          "label": "Holder Company",
          "type": "text"
        },
        {
          "key": "authorizationAt",
          "label": "Authorization Date/Time",
          "type": "datetime"
        }
      ]
    },
    {
      "title": "HAND-BACK AND CLOSE-OUT",
      "items": [
        "Work completed and area inspected",
        "Plant, tools and temporary controls removed",
        "Systems reinstated safely",
        "Area left clean and safe"
      ],
      "fields": [
        {
          "key": "workCompletedSummary",
          "label": "Work Completed Summary",
          "type": "textarea"
        },
        {
          "key": "areaLeftSafeBy",
          "label": "Area Left Safe By",
          "type": "text"
        },
        {
          "key": "handBackTo",
          "label": "Hand-back To (Name)",
          "type": "text"
        },
        {
          "key": "closedBy",
          "label": "Closed By",
          "type": "text"
        },
        {
          "key": "closedAt",
          "label": "Closure Date/Time",
          "type": "datetime"
        },
        {
          "key": "outstandingActions",
          "label": "Outstanding Actions",
          "type": "textarea"
        }
      ]
    }
  ],
  "signatures": [
    "issuer_issue",
    "holder_accept",
    "issuer_close"
  ]
}
