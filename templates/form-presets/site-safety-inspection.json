{
  "id": "site-safety-inspection-v1",
  "title": "Site Safety Inspection Permit",
  "name": "Site Safety Inspection Permit",
  "description": "Permit for conducting site safety inspections to proactively identify and address hazards.",
  "meta": {
    "fields": [
      {
        "key": "inspectionArea",
        "label": "Inspection Area",
        "type": "text",
        "required": true
      },
      {
        "key": "date",
        "label": "Date",
        "type": "date",
        "required": true
      },
      {
        "key": "inspectorName",
        "label": "Inspector Name",
        "type": "text",
        "required": true
      },
      {
        "key": "hazardsIdentified",
        "label": "Hazards Identified",
        "type": "textarea",
        "required": true
      },
      {
        "key": "correctiveActionsRequired",
        "label": "Corrective Actions Required",
        "type": "textarea",
        "required": false
      },
      {
        "key": "supervisor",
        "label": "Supervisor",
        "type": "text",
        "required": false
      },
      {
        "key": "signatures",
        "label": "Signatures",
        "type": "signature",
        "required": true
      },
      {
        "key": "validFrom",
        "label": "Valid From",
        "type": "datetime"
      },
      {
        "key": "validTo",
        "label": "Valid To",
        "type": "datetime"
      }
    ]
  },
  "sections": [
    {
      "title": "GENERAL SITE CONDITIONS",
      "items": [
        "Site access and egress safe",
        "Welfare facilities adequate",
        "Housekeeping standards met",
        "Fire precautions in place",
        "First aid provision checked"
      ],
      "fields": [
        {
          "label": "Inspection Reference No.",
          "type": "text"
        },
        {
          "label": "Inspection Date / Time",
          "type": "datetime"
        },
        {
          "label": "Overall Hazard Severity",
          "type": "select",
          "options": [
            "Low – no immediate action required",
            "Medium – action within 24 hours",
            "High – immediate action required",
            "Critical – work stopped"
          ]
        },
        {
          "label": "Immediate Actions Taken",
          "type": "textarea",
          "placeholder": "Describe any actions taken during inspection"
        }
      ]
    },
    {
      "title": "WORK ACTIVITIES",
      "items": [
        "Permits to work in place",
        "Method statements available",
        "Equipment inspections current",
        "PPE being worn correctly",
        "Environmental controls operating"
      ],
      "fields": [
        {
          "label": "PTW Numbers Currently Active",
          "type": "text",
          "placeholder": "List all active permit numbers"
        },
        {
          "label": "Equipment Inspection Status",
          "type": "select",
          "options": [
            "All current",
            "Some expired – detail in actions",
            "All expired – work stopped"
          ]
        },
        {
          "label": "Non-conformance Reference",
          "type": "text",
          "placeholder": "If NCR raised, enter reference"
        },
        {
          "label": "Follow-up Inspection Date",
          "type": "date"
        }
      ]
    },
    {
      "title": "AUTHORIZATION TO START",
      "fields": [
        {
          "key": "issuerName",
          "label": "Permit Issuer Name",
          "type": "text"
        },
        {
          "key": "issuerRole",
          "label": "Permit Issuer Role",
          "type": "text"
        },
        {
          "key": "holderName",
          "label": "Permit Holder Name",
          "type": "text"
        },
        {
          "key": "holderCompany",
          "label": "Holder Company",
          "type": "text"
        },
        {
          "key": "authorizationAt",
          "label": "Authorization Date/Time",
          "type": "datetime"
        }
      ]
    },
    {
      "title": "HAND-BACK AND CLOSE-OUT",
      "items": [
        "Work completed and area inspected",
        "Plant, tools and temporary controls removed",
        "Systems reinstated safely",
        "Area left clean and safe"
      ],
      "fields": [
        {
          "key": "workCompletedSummary",
          "label": "Work Completed Summary",
          "type": "textarea"
        },
        {
          "key": "areaLeftSafeBy",
          "label": "Area Left Safe By",
          "type": "text"
        },
        {
          "key": "handBackTo",
          "label": "Hand-back To (Name)",
          "type": "text"
        },
        {
          "key": "closedBy",
          "label": "Closed By",
          "type": "text"
        },
        {
          "key": "closedAt",
          "label": "Closure Date/Time",
          "type": "datetime"
        },
        {
          "key": "outstandingActions",
          "label": "Outstanding Actions",
          "type": "textarea"
        }
      ]
    }
  ],
  "signatures": [
    "issuer_issue",
    "holder_accept",
    "issuer_close"
  ]
}
