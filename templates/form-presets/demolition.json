{
  "id": "demolition-v1",
  "title": "Demolition Permit",
  "name": "Demolition Permit",
  "description": "Permit for demolition activities, ensuring all safety, environmental, and regulatory requirements are met.",
  "meta": {
    "fields": [
      {
        "key": "location",
        "label": "Location",
        "type": "text",
        "required": true
      },
      {
        "key": "date",
        "label": "Date",
        "type": "date",
        "required": true
      },
      {
        "key": "structureToBeDemolished",
        "label": "Structure to be Demolished",
        "type": "text",
        "required": true
      },
      {
        "key": "methodOfDemolition",
        "label": "Method of Demolition",
        "type": "textarea",
        "required": true
      },
      {
        "key": "hazardousMaterialsPresent",
        "label": "Hazardous Materials Present",
        "type": "checkbox",
        "required": false
      },
      {
        "key": "personnelInvolved",
        "label": "Personnel Involved",
        "type": "text",
        "required": true
      },
      {
        "key": "supervisor",
        "label": "Supervisor",
        "type": "text",
        "required": true
      },
      {
        "key": "signatures",
        "label": "Signatures",
        "type": "signature",
        "required": true
      },
      {
        "key": "validFrom",
        "label": "Valid From",
        "type": "datetime"
      },
      {
        "key": "validTo",
        "label": "Valid To",
        "type": "datetime"
      }
    ]
  },
  "sections": [
    {
      "title": "PRE-DEMOLITION SURVEY",
      "items": [
        "Structural survey completed",
        "Hazardous materials identified",
        "Services isolated and capped",
        "Demolition sequence planned",
        "Neighboring structures assessed"
      ],
      "fields": [
        {
          "label": "Structural Survey Report Reference",
          "type": "text"
        },
        {
          "label": "Hazardous Materials Present",
          "type": "multiselect",
          "options": [
            {
              "value": "asbestos",
              "label": "Asbestos"
            },
            {
              "value": "lead_paint",
              "label": "Lead paint"
            },
            {
              "value": "pcbs",
              "label": "PCBs"
            },
            {
              "value": "contaminated_soil",
              "label": "Contaminated ground"
            },
            {
              "value": "none",
              "label": "None identified"
            }
          ]
        },
        {
          "label": "Services Isolation Reference",
          "type": "text",
          "placeholder": "Isolation certs / LOTO ref."
        },
        {
          "label": "Demolition Sequence Reference",
          "type": "text"
        }
      ]
    },
    {
      "title": "DEMOLITION CONTROLS",
      "items": [
        "Exclusion zone established",
        "Dust suppression operating",
        "Debris management arranged",
        "Noise monitoring in place",
        "Emergency procedures briefed"
      ],
      "fields": [
        {
          "label": "Demolition Method",
          "type": "select",
          "options": [
            "Hand demolition",
            "Mechanical – hydraulic breaker",
            "Mechanical – long-reach excavator",
            "Explosive demolition",
            "Combined methods"
          ]
        },
        {
          "label": "Exclusion Zone Radius (metres)",
          "type": "text"
        },
        {
          "label": "Dust Suppression Method",
          "type": "select",
          "options": [
            "Water spray / damping down",
            "Misting system",
            "Physical enclosure",
            "Combined"
          ]
        },
        {
          "label": "Noise / Vibration Monitoring Required",
          "type": "select",
          "options": [
            "Yes – equipment deployed",
            "No – not required",
            "Yes – third-party monitoring"
          ]
        },
        {
          "label": "Adjacent Structure Protection Measures",
          "type": "textarea",
          "placeholder": "Describe underpinning, shoring or watching brief"
        }
      ]
    },
    {
      "title": "AUTHORIZATION TO START",
      "fields": [
        {
          "key": "issuerName",
          "label": "Permit Issuer Name",
          "type": "text"
        },
        {
          "key": "issuerRole",
          "label": "Permit Issuer Role",
          "type": "text"
        },
        {
          "key": "holderName",
          "label": "Permit Holder Name",
          "type": "text"
        },
        {
          "key": "holderCompany",
          "label": "Holder Company",
          "type": "text"
        },
        {
          "key": "authorizationAt",
          "label": "Authorization Date/Time",
          "type": "datetime"
        }
      ]
    },
    {
      "title": "HAND-BACK AND CLOSE-OUT",
      "items": [
        "Work completed and area inspected",
        "Plant, tools and temporary controls removed",
        "Systems reinstated safely",
        "Area left clean and safe"
      ],
      "fields": [
        {
          "key": "workCompletedSummary",
          "label": "Work Completed Summary",
          "type": "textarea"
        },
        {
          "key": "areaLeftSafeBy",
          "label": "Area Left Safe By",
          "type": "text"
        },
        {
          "key": "handBackTo",
          "label": "Hand-back To (Name)",
          "type": "text"
        },
        {
          "key": "closedBy",
          "label": "Closed By",
          "type": "text"
        },
        {
          "key": "closedAt",
          "label": "Closure Date/Time",
          "type": "datetime"
        },
        {
          "key": "outstandingActions",
          "label": "Outstanding Actions",
          "type": "textarea"
        }
      ]
    }
  ],
  "signatures": [
    "issuer_issue",
    "holder_accept",
    "issuer_close"
  ]
}
