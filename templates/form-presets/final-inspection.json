{
  "id": "final-inspection-v1",
  "title": "Final Inspection Permit",
  "name": "Final Inspection Permit",
  "description": "Permit for final inspections to ensure a property is ready for occupancy and meets all requirements.",
  "meta": {
    "fields": [
      {
        "key": "propertyArea",
        "label": "Property/Area",
        "type": "text",
        "required": true
      },
      {
        "key": "date",
        "label": "Date",
        "type": "date",
        "required": true
      },
      {
        "key": "inspectorName",
        "label": "Inspector Name",
        "type": "text",
        "required": true
      },
      {
        "key": "inspectionChecklist",
        "label": "Inspection Checklist",
        "type": "textarea",
        "required": true
      },
      {
        "key": "deficienciesNoted",
        "label": "Deficiencies Noted",
        "type": "textarea",
        "required": false
      },
      {
        "key": "signoffAuthority",
        "label": "Sign-off Authority",
        "type": "text",
        "required": true
      },
      {
        "key": "signatures",
        "label": "Signatures",
        "type": "signature",
        "required": true
      },
      {
        "key": "validFrom",
        "label": "Valid From",
        "type": "datetime"
      },
      {
        "key": "validTo",
        "label": "Valid To",
        "type": "datetime"
      }
    ]
  },
  "sections": [
    {
      "title": "COMPLETION VERIFICATION",
      "items": [
        "All works completed per specification",
        "Defects list cleared",
        "Testing and commissioning complete",
        "Documentation handed over",
        "Client sign-off obtained"
      ],
      "fields": [
        {
          "label": "Defects List Reference",
          "type": "text"
        },
        {
          "label": "Outstanding Defects Count",
          "type": "text",
          "placeholder": "Number of open items at time of inspection"
        },
        {
          "label": "Testing & Commissioning Certificate Ref.",
          "type": "text"
        },
        {
          "label": "Client Representative Name",
          "type": "text"
        },
        {
          "label": "Client Acceptance Status",
          "type": "select",
          "options": [
            "Accepted – no defects",
            "Accepted – snagging list agreed",
            "Conditional – major items outstanding",
            "Not accepted"
          ]
        }
      ]
    },
    {
      "title": "HANDOVER & CLOSE-OUT",
      "items": [
        "Area cleaned and tidied",
        "Temporary works removed",
        "Safety systems reinstated",
        "As-built drawings provided",
        "O&M manuals delivered"
      ],
      "fields": [
        {
          "label": "O&M Manuals Delivered To",
          "type": "text"
        },
        {
          "label": "As-built Drawing Reference",
          "type": "text"
        },
        {
          "label": "Handover Certificate Reference",
          "type": "text"
        },
        {
          "label": "Defects Liability Period End Date",
          "type": "date"
        },
        {
          "label": "Outstanding Items Responsibility",
          "type": "textarea",
          "placeholder": "List items, responsible party and due date"
        }
      ]
    }
  ],
  "signatures": [
    "issuer_issue",
    "holder_accept",
    "issuer_close"
  ]
}