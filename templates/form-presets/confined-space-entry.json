{
  "id": "confined-space-entry-v1",
  "title": "Confined Space Entry Permit",
  "name": "Confined Space Entry Permit",
  "description": "Permit for entry into confined spaces, ensuring all safety protocols are met.",
  "meta": {
    "fields": [
      {
        "key": "location",
        "label": "Location",
        "type": "text",
        "required": true
      },
      {
        "key": "date",
        "label": "Date",
        "type": "date",
        "required": true
      },
      {
        "key": "timeIn",
        "label": "Time In",
        "type": "time",
        "required": true
      },
      {
        "key": "timeOut",
        "label": "Time Out",
        "type": "time",
        "required": false
      },
      {
        "key": "entrant(s)",
        "label": "Entrant(s)",
        "type": "text",
        "required": true
      },
      {
        "key": "attendant(s)",
        "label": "Attendant(s)",
        "type": "text",
        "required": true
      },
      {
        "key": "supervisor",
        "label": "Supervisor",
        "type": "text",
        "required": true
      },
      {
        "key": "atmosphericTestingResults",
        "label": "Atmospheric Testing Results",
        "type": "textarea",
        "required": true
      },
      {
        "key": "pPERequired",
        "label": "PPE Required",
        "type": "textarea",
        "required": true
      },
      {
        "key": "rescuePlan",
        "label": "Rescue Plan",
        "type": "textarea",
        "required": true
      },
      {
        "key": "signatures",
        "label": "Signatures",
        "type": "signature",
        "required": true
      }
    ]
  },
  "sections": [
    {
      "title": "ATMOSPHERIC TESTING",
      "items": [
        "Oxygen level 19.5-23.5%",
        "Flammable gas <10% LEL",
        "Toxic gas within safe limits",
        "Continuous monitoring equipment in use",
        "Test results recorded and signed"
      ],
      "fields": [
        {
          "label": "Oxygen Level (%)",
          "type": "text",
          "placeholder": "Safe range 19.5–23.5%"
        },
        {
          "label": "Flammable Gas Level (% LEL)",
          "type": "text",
          "placeholder": "Safe <10% LEL"
        },
        {
          "label": "H2S / CO Level (ppm)",
          "type": "text",
          "placeholder": "Record both if applicable"
        },
        {
          "label": "Testing Equipment Serial No.",
          "type": "text"
        },
        {
          "label": "Monitoring Frequency",
          "type": "select",
          "options": [
            "Continuous",
            "Every 15 minutes",
            "Every 30 minutes",
            "Every 60 minutes"
          ]
        }
      ]
    },
    {
      "title": "VENTILATION & ISOLATION",
      "items": [
        "Forced ventilation operating",
        "All energy sources isolated",
        "Mechanical equipment locked out",
        "Pipelines blanked or disconnected",
        "Entry/exit routes clear and safe"
      ],
      "fields": [
        {
          "label": "Ventilation Type",
          "type": "select",
          "options": [
            "Natural ventilation",
            "Forced supply",
            "Forced exhaust",
            "Both forced supply and exhaust"
          ]
        },
        {
          "label": "Ventilation Flow Rate / Equipment ID",
          "type": "text"
        },
        {
          "label": "Isolation Lock / Tag References",
          "type": "text",
          "placeholder": "List all lock numbers applied"
        },
        {
          "label": "Blanked / Disconnected Lines",
          "type": "textarea",
          "placeholder": "List pipelines or services made safe"
        }
      ]
    },
    {
      "title": "EMERGENCY PREPAREDNESS",
      "items": [
        "Rescue equipment in place",
        "Attendant posted at entry point",
        "Communication system tested",
        "Emergency services notified",
        "Rescue plan briefed to all personnel"
      ],
      "fields": [
        {
          "label": "Rescue Plan Reference",
          "type": "text"
        },
        {
          "label": "Emergency Services Pre-notified",
          "type": "select",
          "options": [
            "Yes",
            "No – rescue team on site",
            "No – not required for this space"
          ]
        },
        {
          "label": "Attendant Name & Contact",
          "type": "text"
        },
        {
          "label": "Communication Device",
          "type": "select",
          "options": [
            "Radio",
            "Mobile phone",
            "Intercom",
            "Lifeline",
            "Other"
          ]
        },
        {
          "label": "Rescue Equipment Location",
          "type": "text"
        }
      ]
    },
    {
      "title": "AUTHORIZATION TO START",
      "fields": [
        {
          "key": "issuerName",
          "label": "Permit Issuer Name",
          "type": "text"
        },
        {
          "key": "issuerRole",
          "label": "Permit Issuer Role",
          "type": "text"
        },
        {
          "key": "holderName",
          "label": "Permit Holder Name",
          "type": "text"
        },
        {
          "key": "holderCompany",
          "label": "Holder Company",
          "type": "text"
        },
        {
          "key": "authorizationAt",
          "label": "Authorization Date/Time",
          "type": "datetime"
        }
      ]
    },
    {
      "title": "HAND-BACK AND CLOSE-OUT",
      "items": [
        "Work completed and area inspected",
        "Plant, tools and temporary controls removed",
        "Systems reinstated safely",
        "Area left clean and safe"
      ],
      "fields": [
        {
          "key": "workCompletedSummary",
          "label": "Work Completed Summary",
          "type": "textarea"
        },
        {
          "key": "areaLeftSafeBy",
          "label": "Area Left Safe By",
          "type": "text"
        },
        {
          "key": "handBackTo",
          "label": "Hand-back To (Name)",
          "type": "text"
        },
        {
          "key": "closedBy",
          "label": "Closed By",
          "type": "text"
        },
        {
          "key": "closedAt",
          "label": "Closure Date/Time",
          "type": "datetime"
        },
        {
          "key": "outstandingActions",
          "label": "Outstanding Actions",
          "type": "textarea"
        }
      ]
    }
  ],
  "signatures": [
    "issuer_issue",
    "holder_accept",
    "issuer_close"
  ]
}
